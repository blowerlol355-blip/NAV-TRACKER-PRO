generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shipment {
  id              String   @id @default(cuid())
  reference       String   @unique
  blNumber        String?  @default("PENDIENTE")
  origin          String
  destination     String
  originPort      String
  destinationPort String
  status          String   @default("Registrado")
  cargoType       String
  weight          Float
  containerCount  Int      @default(0)
  value           Float?
  eta             DateTime?
  departureDate   DateTime?
  arrivalDate     DateTime?
  vesselId        String?
  vessel          Vessel?  @relation(fields: [vesselId], references: [id])
  clientId        String?
  clientName      String?
  notes           String?
  // Cargo Detail Fields
  hsCode          String?
  hsDescription   String?
  productDescription String?
  regulatoryCategory String?
  subcategory     String?
  grossWeight     Float?
  netWeight       Float?
  weightUnit      String?  @default("kg")
  volume          Float?
  packageCount    Int?
  packagingType   String?
  packageDimensions String?
  storageConditions String?
  hazardClass     String?
  unNumber        String?
  packagingGroup  String?
  // Origin Specific
  originCountry   String?
  originRegion    String?
  originMunicipality String?
  originGpsLat    Float?
  originGpsLng    Float?
  productionDate  DateTime?
  batchNumber     String?
  // Destination Specific
  destinationCountry String?
  destinationCustoms String?
  consigneeAddress String?
  incoterm        String?
  incotermPoint   String?
  // Blockchain
  blockchainHash  String?
  qrCodeUrl       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permits         Permit[]
  containers      Container[]
  documents       Document[]
  cargoDetails    CargoDetail[]
  custodyRecords  ChainOfCustody[]
  claims          Claim[]
  crewAssignments CrewAssignment[]
}

model Vessel {
  id              String   @id @default(cuid())
  name            String
  imo             String   @unique
  flag            String
  type            String
  capacity        Int
  currentLocation String?
  status          String   @default("En tránsito")
  speed           Float?
  built           Int?
  owner           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shipments Shipment[]
  documents Document[]
}

model Permit {
  id          String   @id @default(cuid())
  type        String
  number      String   @unique
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  issueDate   DateTime?
  expiryDate  DateTime?
  status      String   @default("Pendiente")
  authority   String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   Document[]
}

model Container {
  id         String   @id @default(cuid())
  number     String   @unique
  type       String
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  weight     Float
  status     String   @default("Vacío")
  sealNumber String?
  dimensions String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  documents  Document[]
}

model Document {
  id               String   @id @default(cuid())
  name             String
  type             String
  shipmentId       String?
  shipment         Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  permitId         String?
  permit           Permit?   @relation(fields: [permitId], references: [id])
  containerId      String?
  container        Container? @relation(fields: [containerId], references: [id])
  vesselId         String?
  vessel           Vessel?    @relation(fields: [vesselId], references: [id])
  portId           String?
  port             Port?      @relation(fields: [portId], references: [id])
  crewId           String?
  crew             Crew?      @relation(fields: [crewId], references: [id])
  fileUrl          String?
  uploadDate       DateTime @default(now())
  expiryDate       DateTime?
  status           String   @default("Vigente")
  fileSize         String?
  category         String?
  // Expanded document fields
  documentSubtype  String?
  issuingAuthority String?
  documentNumber   String?
  isVerified       Boolean  @default(false)
  blockchainHash   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Port {
  id        String   @id @default(cuid())
  name      String
  country   String
  code      String   @unique
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
}

// ===== NEW MODELS =====

model Crew {
  id                String   @id @default(cuid())
  fullName          String
  licenseId         String   @unique
  nationality       String
  identityDoc       String?
  identityDocType   String?  // Pasaporte, Cédula, etc.
  certifications    String?  // JSON: [{name, number, expiryDate}]
  carrierCompany    String?
  emergencyContact  String?
  licenseExpiry     DateTime?
  role              String   @default("Capitán") // Capitán, Piloto, Oficial, Marinero
  status            String   @default("Activo")  // Activo, Inactivo, Licencia Vencida, En viaje
  photoUrl          String?
  email             String?
  phone             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignments CrewAssignment[]
  documents   Document[]
}

model CrewAssignment {
  id          String   @id @default(cuid())
  crewId      String
  crew        Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  role        String   // Capitán, Jefe de Máquinas, Oficial de Cubierta, etc.
  assignedAt  DateTime @default(now())
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([crewId, shipmentId])
}

model CargoDetail {
  id              String   @id @default(cuid())
  shipmentId      String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  // Clasificación del Producto
  description     String   // Descripción comercial
  hsCode          String?  // Código HS (6, 8 o 10 dígitos)
  hsDescription   String?  // Descripción HS oficial
  category        String?  // Categoría normativa
  subcategory     String?  // Subcategoría
  // Características Físicas
  grossWeight     Float?
  netWeight       Float?
  weightUnit      String?  @default("kg")
  volume          Float?   // m³
  packageCount    Int?
  packagingType   String?  // Saco, Caja, Tambor, Tanque, etc.
  packageDimensions String?
  storageTemp     String?
  storageHumidity String?
  storageVentilation String?
  hazardClass     String?  // Clase ADR/IMDG
  unNumber        String?  // Número ONU
  packagingGroup  String?  // Grupo de embalaje
  // Origen Específico
  originCountry   String?
  originRegion    String?
  originMunicipality String?
  originGpsLat    Float?
  originGpsLng    Float?
  productionDate  DateTime?
  batchNumber     String?
  // Destino Específico
  destinationCountry String?
  destinationCustoms String?
  consigneeAddress String?
  incoterm        String?
  incotermPoint   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChainOfCustody {
  id                String   @id @default(cuid())
  shipmentId        String
  shipment          Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  stage             String   // Productor, Acopio, Exportador, Agente de carga, Naviera, Agente destino, Importador
  fromParty         String
  toParty           String
  transferDate      DateTime @default(now())
  responsiblePerson String?
  conditionsVerified String? // JSON: [{condition, verified}]
  digitalSignature  String?
  photoEvidence     String?
  temperature       Float?
  sealsIntact       Boolean?
  notes             String?
  status            String   @default("Completado") // Completado, Pendiente, En proceso
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Claim {
  id                String   @id @default(cuid())
  shipmentId        String
  shipment          Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type              String   // Rechazo en aduana, Daño de mercancía, Documentación incompleta, Retraso, Contaminación
  reason            String
  customsRejection  Boolean  @default(false)
  incidentCost      Float?
  lessonsLearned    String?
  status            String   @default("Abierto") // Abierto, En investigación, Resuelto, Cerrado
  reportedDate      DateTime @default(now())
  resolvedDate      DateTime?
  resolution        String?
  reportedBy        String?
  destinationCountry String?
  regulatoryChange  Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CountryRequirement {
  id              String   @id @default(cuid())
  productCategory String   // Alimento agrícola, Producto forestal, Textil, Químico, etc.
  country         String
  requirementName String
  isMandatory     Boolean  @default(true)
  maxResidueLevel String?
  localLanguageLabel String?
  description     String?
  regulation      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ComplianceCostItem {
  id              String   @id @default(cuid())
  category        String   // Certificación, Inspección, Demora, Arancel
  name            String
  description     String?
  estimatedCost   Float
  currency        String   @default("USD")
  appliesToCountry String?
  appliesToProduct String?
  isRequired      Boolean  @default(true)
  savingsIfCompliant Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
